---
layout: layouts/base.njk
menuBase: index.html
pageTitle: Gabriele Pucciarelli's Blog
---
          <div class="content-area single-page-area">
            <div class="single-page-content">

              <article class="post">

                <div class="post-thumbnail">
                  <img src="{{ image_full or image }}" alt="{{ image_alt or title }}">
                </div>

                <div class="post-content">
                  <!-- /Entry header -->
                  <header class="entry-header">
                    <!-- Entry meta -->
                    <div class="entry-meta entry-meta-top">
                      <span><a href="#" rel="category tag">{{ category }}</a></span>
                    </div>
                    <!-- /Entry meta -->

                    <h2 class="entry-title">{{ title }}</h2>
                  </header>
                  <!-- /Entry header -->

                  <!-- Entry content -->
                  <div class="entry-content">
                    <div class="row">
                      <div class=" col-xs-12 col-sm-12 ">
                        <div class="col-inner">
{{ content | safe }}
                        </div>
                      </div>
                    </div>
                  </div>
                  <!-- /Entry content -->

                  <div class="entry-meta entry-meta-bottom">
                    <div class="date-author">
                      <span class="entry-date">
                        <a href="#" rel="bookmark">
                          <i class="far fa-clock"></i> <span class="entry-date">{{ date_label or ' ' }}</span>
                        </a>
                      </span>
                      <span class="author vcard">
                        <a class="url fn n" href="#" rel="author"> <i class="fas fa-user"></i> Gabriele</a>
                      </span>
                    </div>

                    <!-- Share Buttons -->
                    <div class="entry-share btn-group share-buttons">
                      <a href="https://www.facebook.com/sharer/sharer.php?u=https://www.gabrielepucciarelli.com/{{ page.url | replace('/', '') }}" onclick="javascript:window.open(this.href, '', 'menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=300,width=600');return false;" class="btn" target="_blank" title="Share on Facebook">
                        <i class="fab fa-facebook-f"></i>
                      </a>

                      <a href="https://twitter.com/intent/tweet?url=https://www.gabrielepucciarelli.com/{{ page.url | replace('/', '') }}" onclick="javascript:window.open(this.href, '', 'menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=300,width=600');return false;" class="btn" target="_blank" title="Share on Twitter">
                        <i class="fab fa-twitter"></i>
                      </a>

                      <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://www.gabrielepucciarelli.com/{{ page.url | replace('/', '') }}" onclick="javascript:window.open(this.href,'', 'menubar=no,toolbar=no,resizable=yes,scrollbars=yes,height=600,width=600');return false;" class="btn" title="Share on LinkedIn">
                        <i class="fab fa-linkedin-in"></i>
                      </a>
                    </div>
                    <!-- /Share Buttons -->
                  </div>

                  <div class="post-tags">
                    <div class="tags">
                      {%- for t in topics %}
                      <a href="#" rel="tag">{{ t }}</a>
                      {%- endfor %}
                    </div>
                  </div>
                </div>
              </article>

            </div>
          </div>
